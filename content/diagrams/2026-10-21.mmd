flowchart TB
    subgraph Ingestion["1. INGESTION PIPELINE (Append-Only Writes)"]
        direction TB
        INS1["INSERT INTO events VALUES (...) #40;Batch 1: 10K rows#41;"]
        INS2["INSERT INTO events VALUES (...) #40;Batch 2: 10K rows#41;"]
        
        PART1["📁 Part: 202610_1_1_0\n[Level 0 | 10K rows | active = 1]"]
        PART2["📁 Part: 202610_2_2_0\n[Level 0 | 10K rows | active = 1]"]
        
        INS1 -->|"Sequential Write (No Lock)"| PART1
        INS2 -->|"Sequential Write (No Lock)"| PART2
    end

    subgraph DiskLayout["2. DISK LAYOUT & INTERNALS (Wide Format Part Directory)"]
        direction TB
        subgraph RAM["RAM Resident"]
            PIDX["⚡ primary.idx\n(Sparse Primary Index - 1 Mark per 8192 rows)"]
        end
        subgraph StorageFiles["Disk Storage (.bin & .mrk2)"]
            MRK["📑 event_type.mrk2 | user_id.mrk2\n(Compressed & Decompressed Offsets)"]
            BIN["🗄️ event_type.bin | user_id.bin\n(LZ4 / ZSTD Column Compressed Blocks)"]
            META["📄 count.txt | columns.txt | checksums.txt"]
        end
        PIDX -.->|"Points to Marks"| MRK
        MRK -.->|"Byte Offsets"| BIN
    end

    subgraph Compaction["3. BACKGROUND COMPACTION (MergeTree Engine Thread)"]
        direction TB
        BGMERGE["⚙️ MergeTreeBackgroundExecutor\n- Heuristic Part Selection\n- K-way Merge Sort Algorithm O(N)\n- Streaming I/O (Minimal RAM Footprint)"]
    end

    subgraph Lifecycle["4. PART LIFECYCLE & LOCK-FREE READS (MVCC)"]
        direction TB
        NEWPART["📁 New Consolidated Part: 202610_1_2_1\n[Level 1 | 20K rows | active = 1]\n✅ Served to ALL new incoming SELECT queries"]
        
        subgraph InactiveParts["Inactive Parts (Tombstoned)"]
            INACT1["📁 Part: 202610_1_1_0 [active = 0]"]
            INACT2["📁 Part: 202610_2_2_0 [active = 0]"]
            MVCC_READ["👀 In-flight SELECT queries\ncontinue reading safely without failure"]
            INACT1 & INACT2 -.- MVCC_READ
        end

        HARD_DEL["🗑️ Physical Hard Deletion (Disk Unlink)\nTriggered after old_parts_lifetime (Default: 8 mins / 480s)"]
    end

    PART1 & PART2 ==>|"Scanned by Merge Thread"| BGMERGE
    BGMERGE ==>|"Writes New Unified Part"| NEWPART
    BGMERGE -.->|"Switches metadata status"| InactiveParts
    InactiveParts -->|"After 8 minutes"| HARD_DEL

    classDef ingBox fill:#eff6ff,stroke:#3b82f6,stroke-width:2px;
    classDef layoutBox fill:#f8fafc,stroke:#64748b,stroke-width:2px;
    classDef mergeBox fill:#fef3c7,stroke:#f59e0b,stroke-width:2px;
    classDef successBox fill:#dcfce7,stroke:#22c55e,stroke-width:2px;
    classDef tombBox fill:#fee2e2,stroke:#ef4444,stroke-width:2px,stroke-dasharray: 5 5;
    classDef ramBox fill:#f3e8ff,stroke:#9333ea,stroke-width:2px;

    class Ingestion ingBox;
    class DiskLayout layoutBox;
    class Compaction mergeBox;
    class NEWPART successBox;
    class InactiveParts,INACT1,INACT2,HARD_DEL tombBox;
    class RAM,PIDX ramBox;
